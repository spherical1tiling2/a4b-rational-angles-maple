  ["APP-010", (zeta3^2+zeta3-2)*x^5*y^3-(zeta3^2-zeta3)*x^5*y^2+(2*zeta3^2-2*zeta3+1)*x^4*y^2+zeta3^2*x^4*y-(2*zeta3+1)*x^3*y^2-(2*zeta3^2+1)*x^3*y+(2*zeta3+1)*x^2*y^2+(2*zeta3^2+1)*x^2*y-zeta3*x*y^2+(2*zeta3^2-2*zeta3-1)*x*y-(zeta3^2-zeta3)*y+2-zeta3^2-zeta3],
