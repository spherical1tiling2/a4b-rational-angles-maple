  ["APP-008", 2*x^5*y^3-(zeta4+1)*x^5*y^2+(2*zeta4+1)*x^4*y^2+x^4*y+(2*zeta4+1)*x^3*y^2-(zeta4+2)*x^3*y-(2*zeta4+1)*x^2*y^2+(zeta4+2)*x^2*y+zeta4*x*y^2+(zeta4+2)*x*y-(zeta4+1)*y+2*zeta4],
