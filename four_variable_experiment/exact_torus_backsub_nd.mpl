# Exact finite-index lattice lifting and cyclotomic back-substitution in
# arbitrary dimension.  These routines use only integer congruences and
# common cyclotomic fields; no floating-point root matching is involved.

with(LinearAlgebra):

if not assigned(a4b_solver) then a4b_solver:=table() end if:

`a4b_solver/MapRecordToTable` := proc(rec::list)
    local R,det0;
    R:=table(["rank"=rec[1],"status"=rec[2],"index"=rec[3],
              "basis"=rec[4],"original_variables"=rec[5],
              "variables"=rec[6],"base_exponent"=rec[7],
              "coordinate_shift"=rec[8]]):
    if rec[1]=nops(rec[5]) then
        det0:=Determinant(Matrix(rec[4])):
        R["signed_determinant"]:=det0:
    end if:
    return R:
end proc:

`a4b_solver/RootData` := proc(n,r)
    local rr,g;
    if n=1 then return table(["order"=1,"residue"=0]) end if:
    rr:=irem(r,n):
    if rr=0 then return table(["order"=1,"residue"=0]) end if:
    g:=igcd(rr,n):
    return table(["order"=n/g,"residue"=irem(rr/g,n/g)]):
end proc:

# Lift roots of U_i=prod_j x_j^B[i,j] through a full-rank lattice map.
# If D=|det B| and L is the lcm of the reduced root orders, all lifts live
# in the group generated by eta_(D*L).  An adjugate solution modulo L,
# followed by the D^n possible kernel shifts, gives every lift exactly.
`a4b_solver/LiftTorsionND` := proc(reducedRoots::list,red)
    local n,vars,orig,basis,B,det0,D,L,M,target,sol,p0,out,seen,
          idx,digits,p,i,j,ok,dat,key,roots,tab;
    n:=nops(red["variables"]): vars:=red["variables"]:
    orig:=red["original_variables"]:
    if nops(reducedRoots)<>n then error "root count does not match lattice dimension" end if:
    if red["status"]="full" then
        roots:=[]:
        for i from 1 to n do
            roots:=[op(roots),table(["variable"=orig[i],
                    "order"=reducedRoots[i]["order"],
                    "residue"=reducedRoots[i]["residue"]])]
        end do:
        return [table(["variables"=orig,"roots"=roots,"lift_index"=1])]:
    end if:
    if red["status"]<>"reduced" or red["rank"]<>n then return [] end if:
    basis:=red["basis"]: B:=Matrix(basis): det0:=Determinant(B):
    D:=abs(det0):
    if D<>red["index"] or D=0 then error "invalid full-rank lattice map" end if:
    L:=1:
    for i from 1 to n do L:=ilcm(L,reducedRoots[i]["order"]) end do:
    M:=D*L:
    target:=Vector(n,i->if reducedRoots[i]["order"]=1 then 0
                           else reducedRoots[i]["residue"]*
                                (L/reducedRoots[i]["order"])*D end if):
    sol:=LinearSolve(B,target): p0:=[]:
    for i from 1 to n do
        if not type(sol[i],integer) then error "adjugate lattice solution was not integral" end if:
        p0:=[op(p0),irem(sol[i],L)]:
    end do:
    out:=[]: seen:=table():
    for idx from 0 to D^n-1 do
        digits:=[]: j:=idx:
        for i from 1 to n do digits:=[op(digits),irem(j,D)]: j:=iquo(j,D) end do:
        p:=[seq(p0[i]+digits[i]*L,i=1..n)]: ok:=true:
        for i from 1 to n do
            if irem(add(basis[i][j]*p[j],j=1..n)-target[i],M)<>0 then
                ok:=false: break
            end if:
        end do:
        if ok then
            roots:=[]: key:="":
            for i from 1 to n do
                dat:=`a4b_solver/RootData`(M,p[i]):
                roots:=[op(roots),table(["variable"=orig[i],
                        "order"=dat["order"],"residue"=dat["residue"]])]:
                key:=cat(key,"|",dat["order"],"/",dat["residue"]):
            end do:
            if not assigned(seen[key]) then
                seen[key]:=true:
                tab:=table(["variables"=orig,"roots"=roots,
                            "lift_index"=D,"lift_modulus"=M]):
                out:=[op(out),copy(tab)]:
            end if:
        end if:
    end do:
    return out:
end proc:

`a4b_solver/CommonRootOrder` := proc(roots::list)
    local L,r;
    L:=1:
    for r in roots do L:=ilcm(L,r["order"]) end do:
    return L:
end proc:

# Substitute any number of roots of unity into F in one common cyclotomic
# field.  The result table retains the actual RootOf generator so that a
# coefficient norm can subsequently be formed without approximation.
`a4b_solver/ExactSubstituteRootList` := proc(F,roots::list)
    local L,t,zr,rules,r,rv,G;
    L:=`a4b_solver/CommonRootOrder`(roots):
    t:='_a4b_many_root_generator': zr:=RootOf(cyclotomic(L,t)):
    rules:=[]:
    for r in roots do
        if r["order"]=1 then rv:=1
        else rv:=zr^(r["residue"]*(L/r["order"])) end if:
        rules:=[op(rules),r["variable"]=rv]:
    end do:
    G:=evala(normal(subs(rules,F))):
    return table(["polynomial"=G,"order"=L,"generator"=zr,"rules"=rules]):
end proc:

# Norm a univariate polynomial with coefficients in Q(zeta_L) to Q.
`a4b_solver/AlgebraicCoefficientNorm` := proc(spec,variable)
    local G,L,zr,w,H,Phi,R;
    G:=spec["polynomial"]: L:=spec["order"]: zr:=spec["generator"]:
    if L=1 then return `a4b_solver/PrimitivePolynomial`(G,[variable]) end if:
    w:='_a4b_norm_generator': H:=subs(zr=w,G): Phi:=cyclotomic(L,w):
    R:=expand(resultant(Phi,H,w)):
    return `a4b_solver/PrimitivePolynomial`(R,[variable]):
end proc:

# Return every exact root-of-unity value of the remaining variable that
# solves F after the fixed root list has been substituted.
`a4b_solver/RecoverRemainingUnitRoots` := proc(F,fixedRoots::list,variable)
    local spec,G,RN,diag,n,r,candidate,check,out,seen,key,allRoots;
    spec:=`a4b_solver/ExactSubstituteRootList`(F,fixedRoots):
    G:=spec["polynomial"]:
    if evalb(G=0) then
        return table(["status"="free","roots"=[],"specialized"=G])
    end if:
    if degree(G,variable)=0 then
        return table(["status"="none","roots"=[],"specialized"=G])
    end if:
    RN:=`a4b_solver/AlgebraicCoefficientNorm`(spec,variable):
    diag:=`a4b_solver/UnitRootDiagnostics`(RN,variable):
    out:=[]: seen:=table():
    for n in diag["cyclotomic_orders"] do
        for r in `a4b_solver/PrimitiveResidues`(n) do
            candidate:=table(["variable"=variable,"order"=n,"residue"=r]):
            allRoots:=[op(fixedRoots),candidate]:
            check:=`a4b_solver/ExactSubstituteRootList`(F,allRoots)["polynomial"]:
            if evalb(check=0) then
                key:=cat(n,"/",r):
                if not assigned(seen[key]) then
                    seen[key]:=true: out:=[op(out),copy(candidate)]
                end if:
            end if:
        end do:
    end do:
    return table(["status"="finite","roots"=out,"specialized"=G,
                  "norm"=RN,"diagnostics"=diag]):
end proc:

NULL:
