# Dimension-independent support-lattice reduction for Laurent polynomials.
# It is the n-variable analogue of FullLatticeReduction2D.

with(LinearAlgebra):

if not assigned(a4b_solver) then a4b_solver := table() end if:

`a4b_solver/SupportLatticeReductionND` := proc(F,vars::list)
    local G,n,terms,term,support,e,exps,e0,j,k,rank,H,basis,
          row,newbasis,B,index,U,coords,sol,m,coeff0,R,mins,mon,status,d,diffMat,
          chunkStart,chunkEnd,chunkRows,chunkSize;
    G := `a4b_solver/PrimitivePolynomial`(F,vars):
    n := nops(vars):
    terms := [op(expand(G))]:
    # Expanded polynomial terms have distinct monomial exponent vectors.
    # Build the support once; repeated list appends are quadratic for the
    # very large resultants occurring in the four-variable experiment.
    support := [seq([seq(degree(terms[k],vars[j]),j=1..n)],
                    k=1..nops(terms))]:
    if nops(support)=0 then
        return table(["status"="zero","polynomial"=0,"rank"=0,
                      "variables"=[],"original_variables"=vars])
    elif nops(support)=1 then
        return table(["status"="monomial","polynomial"=1,"rank"=0,
                      "variables"=[],"original_variables"=vars,
                      "base_exponent"=support[1]])
    end if:

    e0 := support[1]:
    # Incremental row-Hermite reduction.  Resultants may have thousands of
    # support points; constructing one huge integer matrix is unnecessary.
    # At every iteration `basis` has at most n rows and spans exactly the
    # lattice generated by all differences seen so far.
    basis := []:
    if nops(support)<=2000 then
        # A single Hermite form is considerably faster for ordinary-sized
        # supports and remains small enough for memory.
        diffMat := Matrix(nops(support)-1,n,
                          (k,j)->support[k+1][j]-e0[j]):
        H := HermiteForm(diffMat):
        for k from 1 to RowDimension(H) do
            row := [seq(H[k,j],j=1..n)]:
            if row<>[seq(0,j=1..n)] then
                basis := [op(basis),row]
            end if:
        end do:
    else
        # Batch large supports.  A batch Hermite form compresses up to 1000
        # new generators back to at most n basis rows, avoiding one costly
        # Maple call per support point while keeping memory bounded.
        chunkSize := 1000:
        for chunkStart from 2 by chunkSize to nops(support) do
            chunkEnd := min(nops(support),chunkStart+chunkSize-1):
            chunkRows := [op(basis),
                seq([seq(support[k][j]-e0[j],j=1..n)],
                    k=chunkStart..chunkEnd)]:
            H := HermiteForm(Matrix(chunkRows)):
            newbasis := []:
            for j from 1 to RowDimension(H) do
                row := [seq(H[j,m],m=1..n)]:
                if row<>[seq(0,m=1..n)] then
                    newbasis := [op(newbasis),row]
                end if:
            end do:
            basis := newbasis:
            # Once the row lattice has full rank and determinant one, later
            # support differences cannot make it any fuller.
            if nops(basis)=n and abs(Determinant(Matrix(basis)))=1 then
                break
            end if:
        end do:
    end if:
    rank := nops(basis):

    if rank=n then
        B := Matrix(basis): index := abs(Determinant(B)):
        if index=1 then
            return table(["status"="full","polynomial"=G,"rank"=n,
                          "index"=1,"variables"=vars,
                          "original_variables"=vars,
                          "basis"=[seq([seq(`if`(j=k,1,0),j=1..n)],k=1..n)],
                          "base_exponent"=[seq(0,j=1..n)],
                          "coordinate_shift"=[seq(0,j=1..n)],
                          "support"=support])
        end if:
    else
        B := Matrix(basis): index := infinity:
    end if:

    U := [seq(cat('_a4b_lat_',j),j=1..rank)]:
    R := 0: mins := [seq(0,j=1..rank)]:
    for k from 1 to nops(support) do
        e := support[k]:
        sol := LinearSolve(Transpose(B),Vector([seq(e[j]-e0[j],j=1..n)])):
        coords := [seq(normal(sol[j]),j=1..rank)]:
        for j from 1 to rank do
            if not type(coords[j],integer) then
                error "support coordinate was not integral in Hermite basis"
            end if:
            if coords[j]<mins[j] then mins[j]:=coords[j] end if:
        end do:
        coeff0 := G:
        for j from 1 to n do coeff0:=coeff(coeff0,vars[j],e[j]) end do:
        R := R+coeff0*mul(U[j]^coords[j],j=1..rank):
    end do:
    mon := mul(U[j]^(-mins[j]),j=1..rank):
    R := expand(mon*R):
    status := if rank<n then "rank_deficient" else "reduced" end if:
    return table(["status"=status,"polynomial"=R,"rank"=rank,
                  "free_dimension"=n-rank,"index"=index,
                  "variables"=U,"original_variables"=vars,
                  "basis"=basis,"base_exponent"=e0,
                  "coordinate_shift"=mins,"support"=support])
end proc:

NULL:
